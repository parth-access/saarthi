# Dependencies & builds
node_modules/
.next/
build/
dist/
coverage/
.vercel/

# TypeScript incremental build cache: machine-local, never shared.
# Committing it makes `tsc` skip re-checking files it believes unchanged,
# which can both invent stale errors and hide real ones.
*.tsbuildinfo

# Environment — real secrets never committed; .env.example documents them.
.env*
!.env.example

