# Copy to .env.local for local development. Set the same keys in Vercel
# (Project → Settings → Environment Variables) for Preview and Production.

# --- Site ---
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Firebase (browser SDK) — Firebase console → Project settings → Your apps ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ihealwithsaarthi.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ihealwithsaarthi
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server) — service-account JSON, base64-encoded:
#     base64 -i service-account.json | tr -d '\n'
FIREBASE_ADMIN_KEY_BASE64=

# --- Auth: signs the __session cookie. Long random string:
#     openssl rand -base64 48
JWT_SECRET=

# --- Razorpay ---
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Google Calendar / Meet (OAuth refresh token for the practice calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Background jobs: shared with the GitHub Actions scheduler (repo secret) ---
CRON_SECRET=

# --- Backup scheduler (optional): lets the daily Vercel cron switch the GitHub
#     schedule back on if GitHub paused it. Fine-grained token with
#     "Actions: read and write" on this repository only.
GITHUB_KEEPALIVE_TOKEN=
GITHUB_KEEPALIVE_REPO=parth-access/saarthi

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Sentry (optional) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Better Auth (migration in progress, not used by the app yet) ---
# docs/plans/2026-10-26-better-auth-migration.md
# Supabase → Project settings → Database → Connection string, *transaction pooler* (port 6543).
DATABASE_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google sign-in: Google Cloud → APIs & Services → Credentials → the Web OAuth client.
# Separate from GOOGLE_CLIENT_ID/SECRET above, which are the Calendar/Meet client.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
# Firebase console → Authentication → Users → ⋮ → Password hash parameters.
# Lets users imported from Firebase sign in with their existing password.
FIREBASE_HASH_SIGNER_KEY=
FIREBASE_HASH_SALT_SEPARATOR=
FIREBASE_HASH_ROUNDS=
FIREBASE_HASH_MEM_COST=
