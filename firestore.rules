rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // GLOBAL DEFAULT DENY
    // Always start with default deny to prevent accidental data exposure.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false; 
    }

    // =========================================================================
    // REUSABLE HELPER FUNCTIONS
    // =========================================================================

    // Check if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the user has an admin role in the users collection
    // Note: This requires the users collection to be strictly protected against role escalation.
    function isAdmin() { 
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Validates that the user is the owner of a given therapist document
    function isTherapistDocOwner(therapistId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/therapists/$(therapistId))
        && get(/databases/$(database)/documents/therapists/$(therapistId)).data.authId == request.auth.uid;
    }

    // Validate that incoming data only contains permitted keys
    // Used to prevent malicious field injection (e.g., injecting a 'role' or 'price' field)
    function hasOnlyKeys(allowedKeys) {
      return request.resource.data.keys().hasOnly(allowedKeys);
    }

    // =========================================================================
    // USERS COLLECTION
    // Stores auth mappings and roles (admin, client)
    // =========================================================================
    match /users/{userId} {
      // Users can read their own profile; admins can read all profiles
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // CRITICAL SECURITY FIX: Only admins can write to users.
      // Allowing clients to write here allows privilege escalation (setting role: "admin").
      // User creation should be handled securely on the server via Cloud Functions or Next.js API.
      allow write: if isAdmin();
    }
    
    // =========================================================================
    // THERAPISTS COLLECTION
    // Public directory of therapists
    // =========================================================================
    match /therapists/{therapistId} {
      // Therapist profiles are public for the booking system
      allow read: if true;

      // Only admins create and delete therapists.
      allow create, delete: if isAdmin();

      // Therapists can update their own profile, or admins can update it.
      // Must prevent updating 'authId' to avoid account takeover.
      allow update: if isAdmin() ||
        (isSignedIn()
         && resource.data.authId == request.auth.uid
         // Prevent changing the linked auth ID
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'specialties', 'avatarUrl'])
        );
    }

    // =========================================================================
    // THERAPIST AVAILABILITY (Nested Collections Architecture)
    // New structure: therapistAvailability/{therapistId}/recurringRules/{ruleId}
    // and therapistAvailability/{therapistId}/overrides/{overrideId}
    // =========================================================================
    match /therapistAvailability/{therapistId} {
      // The parent document can be read by anyone for calendar rendering
      allow read: if true;
      allow write: if isAdmin() || isTherapistDocOwner(therapistId);

      match /recurringRules/{ruleId} {
        allow read: if true;
        // Only the owning therapist or admin can manage these rules
        allow write: if isAdmin() || isTherapistDocOwner(therapistId);
      }

      match /overrides/{overrideId} {
        allow read: if true;
        allow write: if isAdmin() || isTherapistDocOwner(therapistId);
      }
    }
    
    // =========================================================================
    // BOOKINGS COLLECTION
    // =========================================================================
    match /bookings/{bookingId} {
      // Therapists see their own bookings. Admins see all.
      // Clients who created the booking via email or auth should be able to read it if auth is enforced,
      // but in a public system, you might restrict to admin/therapist only and rely on email/tokens.
      allow read, list: if isAdmin() ||
        (isSignedIn() && resource.data.therapistId != null && isTherapistDocOwner(resource.data.therapistId));
      
      // CRITICAL SECURITY FIX: Strict schema enforcement for public bookings
      // - hasOnlyKeys() prevents injecting arbitrary data
      // - Validation ensures strings are non-empty and bounded
      // Note: Ideally, this should be moved to a Server Action/API route. If kept on client, use this:
      allow create: if true 
                     && hasOnlyKeys(['therapistId', 'name', 'email', 'phone', 'date', 'time', 'status', 'createdAt'])
                     && request.resource.data.status == 'pending'
                     && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100
                     && request.resource.data.email is string && request.resource.data.email.matches('^.+@.+\\..+$') && request.resource.data.email.size() < 100
                     && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() < 50
                     && request.resource.data.date is string && request.resource.data.time is string
                     && request.resource.data.createdAt is timestamp;
      
      allow update, delete: if isAdmin() || (isSignedIn() && isTherapistDocOwner(resource.data.therapistId));

      // Nested Audit Logs for bookings
      match /audit_logs/{auditId} {
        allow read: if isAdmin() ||
          (isSignedIn() && get(/databases/$(database)/documents/bookings/$(bookingId)).data.therapistId != null
          && isTherapistDocOwner(get(/databases/$(database)/documents/bookings/$(bookingId)).data.therapistId));
        // Client can create the initial log; only admins/therapists can create subsequent status change logs.
        allow create: if true && hasOnlyKeys(['action', 'status', 'timestamp', 'details'])
                      && request.resource.data.timestamp is timestamp;
      }
    }

    // =========================================================================
    // LOCKED SLOTS COLLECTION
    // =========================================================================
    match /locked_slots/{slotId} {
      allow read: if true;
      allow list: if isAdmin() || isSignedIn();

      // CRITICAL SECURITY FIX: Prevent malicious locking (Denial of Service)
      // Enforce that `expiresAt` MUST exist and must be in the near future (e.g., max 15 mins from now).
      // If `bookingId` exists (a permanent lock), it MUST be created by an admin or server via API.
      allow create: if true
                    && hasOnlyKeys(['therapistId', 'date', 'time', 'createdAt', 'expiresAt', 'lockId'])
                    && request.resource.data.therapistId is string
                    && request.resource.data.date is string
                    && request.resource.data.time is string
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.expiresAt is timestamp
                    // Ensure expiration is not maliciously set far into the future (max 15 mins)
                    && request.resource.data.expiresAt <= request.time + duration.value(15, 'm');

      // Only server/admins or owning therapist can delete/update
      allow delete: if isAdmin() || (isSignedIn() && isTherapistDocOwner(resource.data.therapistId));
      allow update: if false; // Locks should never be updated client-side, only created or deleted.
    }

    // =========================================================================
    // CONTACTS / INQUIRIES COLLECTION
    // =========================================================================
    match /contacts/{contactId} {
      // CRITICAL SECURITY FIX: Enforce exact keys and types to prevent NoSQL injection.
      allow create: if true 
                     && hasOnlyKeys(['name', 'email', 'message', 'createdAt', 'status', 'priority', 'source', 'lastUpdatedAt'])
                     && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100
                     && request.resource.data.email is string && request.resource.data.email.matches('^.+@.+\\..+$')
                     && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() < 2000
                     && request.resource.data.status == 'unread'
                     && request.resource.data.priority in ['normal', 'high']
                     && request.resource.data.source == 'website'
                     && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }
  }
}
