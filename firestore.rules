rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Simple rules for Saarthi
    
    match /bookings/{bookingId} {
      allow read, write: if false;
    }
    
    match /contacts/{contactId} {
      allow read, write: if false;
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
