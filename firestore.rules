rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
    =========================================
    HELPERS
    =========================================
    */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTherapistDocOwner(therapistId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/therapists/$(therapistId))
        && get(/databases/$(database)/documents/therapists/$(therapistId)).data.authId == request.auth.uid;
    }

    /*
    =========================================
    USERS
    =========================================
    */

    match /users/{userId} {

      allow read: if
        isSignedIn()
        && (
          request.auth.uid == userId ||
          isAdmin()
        );

      allow create: if
        isSignedIn()
        && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'client');

      allow update: if
        isSignedIn()
        && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    /*
    =========================================
    THERAPISTS
    =========================================
    */

    match /therapists/{therapistId} {

      allow read: if true;

      allow create: if isAdmin();

      allow update: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.authId == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    /*
    =========================================
    AVAILABILITY RULES
    =========================================
    */

    match /availability_rules/{ruleId} {

      allow read: if true;

      allow create: if
        isAdmin()
        || isTherapistDocOwner(request.resource.data.therapistId);

      allow update, delete: if
        isAdmin()
        || isTherapistDocOwner(resource.data.therapistId);
    }

    /*
    =========================================
    BOOKINGS
    =========================================
    */

    match /bookings/{bookingId} {

      allow read, list: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.therapistId != null
          && isTherapistDocOwner(resource.data.therapistId)
        )
        || (
          isSignedIn()
          && (
            (resource.data.email != null && resource.data.email == request.auth.token.email) ||
            (resource.data.userId != null && resource.data.userId == request.auth.uid)
          )
        );

      allow write: if false;

      /*
      =========================================
      BOOKING AUDIT LOGS
      =========================================
      */

      match /audit_logs/{auditId} {

        allow read: if
          isAdmin()
          || (
            isSignedIn()
            && get(/databases/$(database)/documents/bookings/$(bookingId)).data.therapistId != null
            && isTherapistDocOwner(
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.therapistId
            )
          )
          || (
            isSignedIn()
            && get(/databases/$(database)/documents/bookings/$(bookingId)).data.email == request.auth.token.email
          );

        allow write: if false;
      }
    }

    /*
    =========================================
    LOCKED SLOTS
    =========================================
    */

    match /locked_slots/{slotId} {

      allow read: if true;

      allow write: if false;
    }

    /*
    =========================================
    PAYMENTS
    =========================================
    */

    match /payments/{paymentId} {

      allow read: if
        isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
        );

      allow write: if false;
    }

    /*
    =========================================
    CONTACTS
    =========================================
    */

    match /contacts/{contactId} {

      allow create: if false;

      allow read, update, delete: if isAdmin();
    }

    /*
    =========================================
    RESCHEDULE REQUESTS
    =========================================
    */

    match /reschedule_requests/{reqId} {

      allow create: if
        isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if
        isAdmin()
        || (
          isSignedIn()
          && isTherapistDocOwner(resource.data.therapistId)
        );
    }

    /*
    =========================================
    THERAPIST RECONNECT REQUESTS
    =========================================
    */

    match /therapist_reconnect_requests/{reqId} {

      allow create: if
        isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if isAdmin();
    }

    /*
    =========================================
    DEFAULT DENY
    =========================================
    */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}